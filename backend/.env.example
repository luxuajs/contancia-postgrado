# Para desarrollo local del backend (sin Docker)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://facesuc:facesuc_dev_password@localhost:5432/facesuc?schema=public
# JWT_SECRET: Cambiar por un valor fuerte y aleatorio de al menos 32 caracteres en producción.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_2026_minimo_32_caracteres
JWT_EXPIRES_IN=8h
# CORS_ORIGIN: En producción poner el dominio real, separado por comas si es necesario.
CORS_ORIGIN=http://localhost:5173
TEMPLATE_PATH=./templates/Notas.docx
ROOT_EMAIL=dticucfaces@gmail.com
ROOT_PASSWORD=Cambiar123!
ROOT_NOMBRE=Super Usuario ROOT FACES
LOGO_UC_PATH=./templates/logos/uc.png
LOGO_POSTGRADO_PATH=./templates/logos/faces-postgrado.png
# Nombre que firma al pie de la constancia
PROFESOR_COORDINACION=Prof. Karla Padrón
# BD local de SUCAI (MySQL en Docker). Vista: v_expedientes_alumnos_completo
SUCAI_DB_HOST=127.0.0.1
SUCAI_DB_PORT=3306
SUCAI_DB_USER=root
SUCAI_DB_PASSWORD=
SUCAI_DB_NAME=sucai_local

# Correo (Gmail + app password de 16 caracteres, sin espacios)
SMTP_USER=dticucfaces@gmail.com
SMTP_PASS=
APP_URL=http://localhost:5173

# Contrato de la API: 'aviso' registra en consola las líneas [contrato] (no bloquea); 'off' la apaga.
CONTRATO_VALIDACION=aviso
CONTRATO_RUTA=../contracts/dist/openapi.bundled.yml
